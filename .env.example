# Namespace shared by every E2E run. Each `make e2e` invocation creates a
# fresh, uniquely named resource set (VM, disk, backups, tracker) inside this
# one namespace, labeled for scripts/clean-all.sh to find and remove; the
# namespace itself is never created or deleted per run.
NAMESPACE=vm-cbt-demo

# Optional kubeconfig path. Leave empty to use the standard KUBECONFIG
# environment variable or the kubectl/oc default.
KUBECONFIG_PATH=

# Private key generated for the demo guest. The default keeps it in the
# repository-local, gitignored keys/ directory.
GUEST_KEY=keys/id_ed25519

# Required only for sync.sh; do not use production credentials in this file.
REMOTE_HOST=example-host
REMOTE_DIR=/path/to/remote/cbt-setup

# Size (MiB) of the random payload written to the guest file at vm-setup time
# and appended again before the incremental backup. Larger values exercise a
# more realistic CBT block delta at the cost of extra backup time and PVC
# space; both must comfortably fit within the manifests' PVC sizes.
GUEST_DATA_SIZE_MB=64
GUEST_INCREMENTAL_DATA_SIZE_MB=32

# Manifest sizing variant: "default" (5Gi/5Gi/3Gi PVCs) or "large" (40Gi/40Gi/25Gi
# PVCs, for chaos-testing scenarios that need a longer, disk-bound
# backup-copy window — see cbt-chaos/chaos-plan.md). Leave as "default" for
# the normal fast demo. When set to "large", also raise GUEST_DATA_SIZE_MB
# and GUEST_INCREMENTAL_DATA_SIZE_MB (measured on cbt-demo-hpp: 8192/12288
# MiB produced a ~28s full backup and a ~16s incremental backup; at the
# default 64/32 MiB the large manifests still finish in a few seconds, since
# the copy is page-cache-absorbed at that scale).
MANIFEST_VARIANT=default

# Required only for `make vm-cbt-restore-test`. Image used by the short-lived
# restore-verification pod; must provide qemu-img and util-linux. Build and
# push images/restore-helper/Dockerfile to a registry you control, then set
# this to that reference, e.g.:
#   podman build -t quay.io/<you>/cbt-restore-helper:latest images/restore-helper
#   podman push quay.io/<you>/cbt-restore-helper:latest
RESTORE_HELPER_IMAGE=quay.io/<you>/cbt-restore-helper:latest
