# Namespace shared by every E2E run. TYPE=all/full creates a fresh, uniquely
# named resource set; TYPE=incremental/verify reuses the VM named by VM.
# Every workflow resource is labeled for scripts/clean-all.sh to find and
# remove; the namespace itself is never created or deleted per run.
NAMESPACE=vm-cbt-demo

# Guest OS profile for `make e2e`. Debian remains the default; choose `rhel9`
# to use the cluster-provided RHEL 9 DataSource, or `windows` for Windows
# Server 2022. A missing Windows golden image is built when ISO/password are set.
VM_OS=debian

# Optional kubeconfig path. Leave empty to use the standard KUBECONFIG
# environment variable or the kubectl/oc default.
KUBECONFIG_PATH=

# Private key generated for the demo guest. The default keeps it in the
# repository-local, gitignored keys/ directory.
GUEST_KEY=keys/id_ed25519

# Required only for sync.sh; do not use production credentials in this file.
REMOTE_HOST=example-host
REMOTE_DIR=/path/to/remote/cbt-setup

# Number of deterministic files created before the full backup and added in
# each incremental pass. File sizes are selected reproducibly from this
# inclusive whole-MiB range; the run manifest records each file's size.
GUEST_BASE_FILE_COUNT=8
GUEST_INCREMENTAL_FILE_COUNT=4
# Number of incremental backup passes after the single full backup.
# Each pass adds GUEST_INCREMENTAL_FILE_COUNT new files to the same VM.
# Default 1 preserves the traditional one-increment E2E profile.
# Each pass retains a separate incremental backup PVC until `make clean-all`,
# so provisioned backup storage grows with the pass count.
GUEST_INCREMENTAL_PASSES=1

# TYPE=extend only: target total pass count for one incremental extension.
# Example: EXTEND_TO_PASS=4 adds pass 4 to a completed three-pass lifecycle.
EXTEND_TO_PASS=
GUEST_FILE_SIZE_MIN_MIB=4
GUEST_FILE_SIZE_MAX_MIB=12

# Keep state transitions and a 30-second heartbeat in normal output.
# Set true to add detailed backup-condition and VMI-status snapshots.
DEBUG=false


# Manifest variant: "odf" (the default; 6Gi/6Gi/4Gi PVCs backed by the
# ocs-storagecluster-ceph-rbd StorageClass instead of cbt-demo-hpp — see
# docs/odf-setup-plan.md; requires ODF deployed on the cluster), "default"
# (5Gi/5Gi/3Gi PVCs on cbt-demo-hpp, for clusters without ODF), "large"
# (40Gi/40Gi/25Gi PVCs on cbt-demo-hpp, the optional Debian chaos-testing
# profile — see cbt-chaos/chaos-plan.md), or "large-odf"
# (48Gi/48Gi/30Gi PVCs on ocs-storagecluster-ceph-rbd for the optional Debian
# chaos-testing profile). ODF uses strict PVC capacity; CDI filesystem
# overhead can increase the actual root PVC request beyond the DataVolume size.
# RHEL 9 uses an 80Gi root DataVolume request and 80Gi full-backup PVC on the
# selected backend. Each incremental PVC remains 25Gi on HPP or 30Gi on ODF.
# Historical RHEL 9 large-odf measurement at 48Gi: the root DataVolume request
# became a 50.88Gi PVC request / 51Gi capacity; root/full/incremental claims
# totaled 128.88Gi, plus a ~0.54Gi persistent-state request. The current
# 80Gi RHEL ODF profile with three passes requests 250Gi nominally across
# root/full/three incremental claims, before CDI root overhead and persistent
# state. Check available cluster capacity. Restore verification adds no PVC.
# See docs/vm-cbt-workflow.md#rhel-9-storage-footprint.
# Debian large-disk chaos starting point: 8 baseline files, 11 additions, and
# a 512-1536MiB range currently totals 8511/12858MiB by the deterministic
# filename assignment. These are not measured timings; verify with monitor.sh.
MANIFEST_VARIANT=odf

# Required when no completed Windows golden DataSource exists. Set only when
# DataVolume vm-cbt-images/windows-iso is not already Succeeded; this local
# ISO path is used for the CDI upload and is never copied into the repository.
WINDOWS_ISO_PATH=

# Required for Windows VM setup and the first-time golden-image build. Store
# the Administrator password in a local gitignored file such as
# .windows-admin-password; never commit it or put the password in this file.
WINDOWS_ADMIN_PASSWORD_FILE=
# Required only for `make vm-cbt-restore-test`. The helper image must provide
# qemu-img, util-linux, and ntfs-3g; build/push images/restore-helper/Dockerfile
# to a registry you control, then set this to that reference, e.g.:
#   podman build -t quay.io/<you>/cbt-restore-helper:latest images/restore-helper
#   podman push quay.io/<you>/cbt-restore-helper:latest
RESTORE_HELPER_IMAGE=quay.io/<you>/cbt-restore-helper:latest
