# Local configuration and secrets
.env
.env.*
!.env.example
.windows-admin-password
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kubeconfig
kubeconfig
.kube/

# AI-generated artifacts (reports, matrices, bug reports, analysis, plans,
# closed-run evidence) — one dir per scenario plus _-prefixed categories.
# Kept out of git; scripts/archive-run.sh files closed runs here.
/artifacts/

# Generated workflow state and credentials
/keys/
/state/
/report/
/report-*.tar.gz
vm-cbt-demo/
*.vm-cbt-managed
*.log
logs/
tmp/
tmp-*/
/screenshot/
# CBT generated run artifacts
# Run-scoped workflow state, reports, and evidence are local artifacts.

/runs/

# Follow-up experiment raw captures (per-leg cluster evidence: component logs,
# namespace event dumps, VMI/PVC snapshots). Same class as runs/** above: the
# narrative and its citations are committed (*.md); the raw captures stay local.
/cbt-chaos/scenarios_v2/*/followup/*/*
!/cbt-chaos/scenarios_v2/*/followup/*/*.md

# Density pool records (expected VM lists; run adoption state lives in runs/)
/density/

/cbt-chaos/scenarios/*/runs/

# Canonical v2 attempt state, raw captures and logs remain local. Only the
# sanitized per-attempt narrative is eligible for version control; scenario-root
# consolidated-report.md, bugs/*.md and proposed scenario drafts remain visible.
/cbt-chaos/scenarios_v2/*/runs/**
!/cbt-chaos/scenarios_v2/*/runs/*/
!/cbt-chaos/scenarios_v2/*/runs/*/run-report.md
/cbt-chaos/scenarios_v2/*/approval.json

