#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/dotenv.sh
source "$ROOT_DIR/scripts/dotenv.sh"
VERBOSE=0
CHECKS=0
PASSED=0
WARNINGS=0
FAILURES=0
SECTION_NUMBER=0
TOTAL_SECTIONS=7


usage() {
  cat <<'USAGE'
Usage: ./preflight [--verbose] [--help]

Check whether this repository's KubeVirt CBT workflow can run safely.
The checks are read-only with respect to the cluster; nothing is installed
and no Kubernetes resource is created, changed, or deleted.
USAGE
}

while (($#)); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --verbose|-v) VERBOSE=1 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

cleanup() {
  if [[ -n "$TMP_DIR" && -d "$TMP_DIR" ]]; then
    rm -rf "$TMP_DIR"
  fi
}
trap cleanup EXIT INT TERM

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/cbt-preflight.XXXXXX")"
section() {
  SECTION_NUMBER=$((SECTION_NUMBER + 1))
  printf '\n[preflight %d/%d] %s\n' "$SECTION_NUMBER" "$TOTAL_SECTIONS" "$1"
}

result() {
  local state="$1" message="$2"
  CHECKS=$((CHECKS + 1))
  case "$state" in
    PASS) PASSED=$((PASSED + 1)); printf 'PASS  %s\n' "$message" ;;
    WARN) WARNINGS=$((WARNINGS + 1)); printf 'WARN  %s\n' "$message" ;;
    FAIL) FAILURES=$((FAILURES + 1)); printf 'FAIL  %s\n' "$message" ;;
    *) printf 'FAIL  Internal preflight error\n' >&2; exit 2 ;;
  esac
}

check_command() {
  local name="$1" hint="$2" version=
  if ! command -v "$name" >/dev/null 2>&1; then
    result FAIL "$name is missing or not executable; $hint"
    return
  fi
  if [[ "$name" == oc ]]; then
    version="$(oc version --client 2>/dev/null | sed -n '1p' || true)"
  elif [[ "$name" == ssh ]]; then
    version="$(ssh -V 2>&1 | sed -n '1p' || true)"
  elif [[ "$name" == make || "$name" == bash ]]; then
    version="$("$name" --version 2>/dev/null | sed -n '1p' || true)"
  fi
  [[ -n "$version" ]] && result PASS "$name is available ($version)" || result PASS "$name is available"
}
load_dotenv_defaults "$ROOT_DIR/.env"


KUBECONFIG_PATH="${KUBECONFIG_PATH:-${KUBECONFIG:-}}"
GUEST_KEY="${GUEST_KEY:-$ROOT_DIR/keys/id_ed25519}"
if [[ -n "$KUBECONFIG_PATH" ]]; then export KUBECONFIG="$KUBECONFIG_PATH"; fi

check_repository() {
  section "Repository"
  [[ -f "$ROOT_DIR/Makefile" ]] && result PASS "Makefile found" || result FAIL "Makefile is missing"
  for file in scripts/common.sh scripts/dotenv.sh scripts/vm-setup.sh scripts/vm-backup.sh scripts/vm-cbt-backup.sh scripts/vm-cbt-verify.sh manifests/vm.yaml manifests/full-backup.yaml manifests/incremental-backup.yaml; do
    [[ -f "$ROOT_DIR/$file" ]] && result PASS "$file found" || result FAIL "$file is missing"
  done
}

check_cli_tools() {
  section "CLI Tools"
  check_command bash "install Bash 3.2 or newer"
  check_command make "install make"
  check_command oc "install the OpenShift CLI (oc)"
  check_command ssh "install an OpenSSH client"
  check_command ssh-keygen "install OpenSSH client tools"
  for command_name in sed mktemp grep sleep kill cat mkdir rm rmdir chmod awk stat; do
    check_command "$command_name" "install the command or restore the standard OS utilities"
  done
  if command -v rsync >/dev/null 2>&1; then
    result PASS "rsync is available for optional sync.sh"
  else
    result WARN "rsync is missing; sync.sh cannot be used (not required for make e2e)"
  fi
}

check_environment() {
  section "Environment"
  if [[ -n "$KUBECONFIG_PATH" ]]; then
    if [[ -f "$KUBECONFIG_PATH" && -r "$KUBECONFIG_PATH" ]]; then
      result PASS "configured kubeconfig is a readable file"
    else
      result FAIL "KUBECONFIG_PATH is not a readable file"
    fi
  else
    result PASS "using oc's standard kubeconfig/context resolution"
  fi
  if [[ -r "$ROOT_DIR/.env" ]]; then
    result PASS ".env is readable and supported values were loaded without executing it"
  else
    result WARN ".env is absent; environment variables and oc defaults will be used"
  fi
}

check_cluster_access() {
  section "Cluster Access"
  if ! command -v oc >/dev/null 2>&1; then
    result FAIL "oc is required before cluster access can be checked"
    return
  fi

  local current_context
  current_context="$(oc config current-context 2>"$TMP_DIR/oc-error" || true)"
  [[ -n "$current_context" ]] && result PASS "an OpenShift context is selected" || result FAIL "no usable kubeconfig context is selected"
  if oc whoami >"$TMP_DIR/whoami" 2>"$TMP_DIR/oc-error"; then
    result PASS "oc authentication succeeded"
  else
    result FAIL "oc authentication failed; log in with oc or fix the kubeconfig"
  fi
  if oc get --raw=/version >"$TMP_DIR/version" 2>"$TMP_DIR/oc-error"; then
    result PASS "cluster API is reachable"
  else
    result FAIL "cluster API is not reachable; check the server, network, and credentials"
  fi
}

check_cluster_capabilities() {
  section "Cluster Capabilities"
  if ! command -v oc >/dev/null 2>&1; then
    result FAIL "cluster capabilities cannot be checked without oc"
    return
  fi

  local feature_gates
  for crd in virtualmachines.kubevirt.io virtualmachinebackups.backup.kubevirt.io virtualmachinebackuptrackers.backup.kubevirt.io datavolumes.cdi.kubevirt.io datasources.cdi.kubevirt.io; do
    if oc get crd "$crd" >/dev/null 2>"$TMP_DIR/oc-error"; then
      result PASS "required CRD $crd is installed"
    else
      result FAIL "required CRD $crd is unavailable"
    fi
  done
  if oc get storageclass cbt-demo-hpp >/dev/null 2>"$TMP_DIR/oc-error"; then
    result PASS "storage class cbt-demo-hpp is available"
  else
    result FAIL "storage class cbt-demo-hpp is unavailable"
  fi

  if feature_gates="$(oc get kubevirt -A -o 'jsonpath={range .items[*]}{.spec.configuration.developerConfiguration.featureGates}{"\n"}{end}' 2>"$TMP_DIR/oc-error")" &&
     printf '%s\n' "$feature_gates" | grep -Eq '(^|[^[:alnum:]])IncrementalBackup([^[:alnum:]]|$)'; then
    result PASS "IncrementalBackup feature gate is configured"
  else
    result FAIL "IncrementalBackup feature gate is not confirmed in KubeVirt configuration"
  fi
  # The cluster's CBT selector is intentionally not a preflight gate. Some
  # KubeVirt versions do not expose the selector consistently through this
  # field, while vm-setup.sh and vm-cbt-verify.sh validate actual CBT state.
  # cbt-demo=enabled remains the label supplied by manifests/vm.yaml.

  for permission in 'create namespaces' 'create virtualmachines' 'create virtualmachinebackups' 'delete namespaces'; do
    local verb="${permission%% *}" resource="${permission#* }"
    if oc auth can-i "$verb" "$resource" >/dev/null 2>"$TMP_DIR/oc-error"; then
      result PASS "permission to $verb $resource is available"
    else
      result FAIL "permission to $verb $resource is missing"
    fi
  done
}

check_guest_ssh() {
  section "VM/SSH"
  if [[ -f "$GUEST_KEY" && -r "$GUEST_KEY" ]]; then
    result PASS "guest private key is readable"
    local key_mode
    key_mode="$(stat -c '%a' "$GUEST_KEY" 2>/dev/null || stat -f '%Lp' "$GUEST_KEY" 2>/dev/null || true)"
    if [[ "$key_mode" == 600 || "$key_mode" == 400 ]]; then
      result PASS "guest private key permissions are owner-only"
    else
      result FAIL "guest private key permissions must be 0600 or 0400"
    fi
    if ssh-keygen -y -f "$GUEST_KEY" >"$TMP_DIR/derived.pub" 2>"$TMP_DIR/key-error"; then
      result PASS "guest private key is a valid SSH key"
      if [[ -f "$GUEST_KEY.pub" && -r "$GUEST_KEY.pub" ]]; then
        local expected actual
        expected="$(awk '{print $1 " " $2}' "$TMP_DIR/derived.pub")"
        actual="$(awk '{print $1 " " $2}' "$GUEST_KEY.pub")"
        [[ "$expected" == "$actual" ]] && result PASS "guest public/private key pair matches" || result FAIL "guest public key does not match the private key"
      else
        result WARN "guest public key is absent; vm-setup.sh can derive it from the private key"
      fi
    else
      result FAIL "guest private key cannot be validated"
    fi
  else
    result WARN "guest private key is missing; vm-setup.sh will generate it at the configured path"
  fi
}

check_permissions() {
  section "Permissions"
  for script in preflight scripts/*.sh sync.sh; do
    if [[ -x "$ROOT_DIR/$script" ]]; then
      result PASS "$script is executable"
    else
      result FAIL "$script is not executable"
    fi
  done
  local probe_dir
  if probe_dir="$(mktemp -d "$TMP_DIR/work.XXXXXX" 2>/dev/null)"; then
    result PASS "temporary work directory can be created"
    rmdir "$probe_dir"
  else
    result FAIL "temporary work directory cannot be created"
  fi
}

print_summary() {
  printf '\nSummary: %d checks; %d passed; %d warnings; %d failures\n' "$CHECKS" "$PASSED" "$WARNINGS" "$FAILURES"
  if ((VERBOSE)); then
    printf 'Diagnostics: detailed command errors were suppressed to avoid exposing credentials or kubeconfig data.\n'
  fi
  if ((FAILURES == 0)); then
    printf 'READY: environment is prepared for the repository workflow.\n'
    return 0
  fi
  printf 'NOT READY: resolve the failed checks before running make e2e.\n'
  return 1
}

check_repository
check_cli_tools
check_environment
check_cluster_access
check_cluster_capabilities
check_guest_ssh
check_permissions
print_summary
